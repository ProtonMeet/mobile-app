# RNNoise: built from source at compile time (scripts/rnnoise/build_rnnoise.sh).
third_party/rnnoise/lib/
.rnnoise-build/
# DeepFilter Apple dylibs: build-only staging; ship ios/DeepFilter.xcframework + macos/DeepFilter.framework.
third_party/deepfilter/lib/ios/
third_party/deepfilter/lib/macos/
# RNNoise Android native build is under <repo>/build/native/proton_denoise/cxx (see build.gradle.kts).

# CocoaPods prepare_command symlinks (scripts/link_apple_pod_sources.sh).
# Canonical sources: common/darwin/Classes/*.swift and common/cpp/src/*.cc — do not duplicate here.
# After adding/removing shared sources, run: cd macos && pod install  (and ios/ for iOS).
ios/Classes/
ios/Cpp/
ios/Native/
ios/Vendored/
ios/Resources/DeepFilterNet3_onnx.tar.gz
# Binary inputs staged by scripts/spm/prepare_ios_spm.sh.
ios/proton_denoise/VendoredFrameworks/
ios/proton_denoise/Sources/proton_denoise/Resources/DeepFilterNet3_onnx.tar.gz
macos/Classes/
macos/Cpp/
macos/Native/
macos/Vendored/
macos/Resources/DeepFilterNet3_onnx.tar.gz
# Binary inputs staged by scripts/spm/prepare_macos_spm.sh.
macos/proton_denoise/VendoredFrameworks/
macos/proton_denoise/Sources/proton_denoise/Resources/DeepFilterNet3_onnx.tar.gz

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/
